# Copy to .env and replace the password, or run: python -m backend.app.bootstrap --demo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
APP_TIMEZONE=Europe/Moscow
DATABASE_PATH=./data/invoice-keeper.sqlite3
SESSION_HOURS=12
# Enable only behind HTTPS. Local HTTP needs false.
COOKIE_SECURE=false
APP_ALLOWED_HOSTS=127.0.0.1,localhost,::1
# For an HTTPS reverse proxy, set its exact public origin, e.g. https://keeper.example.com
PUBLIC_BASE_URL=
# Sending is disabled until explicitly enabled. Demo never sends messages.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMINDER_INTERVAL_SECONDS=60

# Payment buttons. For private chat its owner is trusted automatically.
# For a group, explicitly list Telegram user IDs allowed to confirm payments.
TELEGRAM_BUTTONS_ENABLED=true
# Owner-only menu, lists, summary and payment cards. Uses the same trusted user IDs.
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_ALLOWED_USER_IDS=

# Email. Use a provider's application password, never commit it.
SMTP_ENABLED=false
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Signed outgoing webhook. URL must use HTTPS and a public destination.
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
# Enable only for a local test receiver; permits HTTP to loopback, not LAN/metadata.
WEBHOOK_ALLOW_LOCALHOST=false
IN_APP_ENABLED=true
