{
  "title": "AezaKeeper · Финансы и доставка",
  "uid": "keeper-finance",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Просроченные неоплаченные периоды активных платежей. Валюты считаются отдельно; это не остаток банковского счёта. Сроки определяются APP_TIMEZONE.",
  "tags": [
    "invoice-keeper",
    "finance"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Просроченные платежи",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "keeper-prometheus"
      },
      "targets": [
        {
          "expr": "sum(keeper_overdue_payments)",
          "refId": "A",
          "legendFormat": "Просроченные платежи"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Ожидают оплаты",
