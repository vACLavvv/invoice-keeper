{
  "name": "invoice-keeper-frontend",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/i18n-check.mjs && next build && node scripts/publish.mjs",
    "typecheck": "tsc --noEmit",
    "i18n": "node scripts/i18n-check.mjs",
    "test:timezone": "node --test scripts/date-timezone-check.mjs",
    "test:live": "node --test scripts/live-updates-check.mjs",
    "test:browser-notices": "node --test scripts/browser-notices-check.mjs",
    "test:async-load": "node --test scripts/async-load-check.mjs",
    "test:idempotency": "node --test scripts/idempotency-check.mjs",
    "test:webhooks": "node --test scripts/webhook-editor-check.mjs",
    "test:extension": "node --test scripts/extension-wallet-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
