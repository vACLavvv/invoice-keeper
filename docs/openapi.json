{
  "openapi": "3.1.0",
  "info": {
    "title": "Invoice Keeper API",
    "version": "1.0.0",
    "description": "Учёт регулярных платежей команды: периоды оплаты, просрочки, итоги по валютам и напоминания в Telegram.\n\n**Авторизация.** `POST /auth/login` ставит HttpOnly-cookie `invoice_session` и возвращает `csrf_token`.\nВсе изменяющие запросы (кроме входа) требуют заголовок `X-CSRF-Token` с этим значением; токен также отдаёт `GET /auth/me`.\nВ Swagger браузер использует открытую cookie-сессию — укажите токен в Authorize → csrfToken.\n\n**Форматы.** Суммы — десятичные строки с двумя знаками (`\"45000.00\"`), без конвертации между валютами.\nДаты — `YYYY-MM-DD` в часовом поясе приложения (`GET /settings`). Ошибки: `{\"detail\": \"текст\"}` или список ошибок полей.\n\n**Роли.** `admin` задаётся в `.env`; `user` создаёт администратор. Ограничения ролей проверяются на сервере."
  },
  "servers": [
    {
      "url": "/",
      "description": "Этот сервер"
    }
  ],
  "tags": [
    {
      "name": "Авторизация"
    },
    {
      "name": "Регулярные платежи"
    },
    {
      "name": "Оплаты"
    },
    {
      "name": "Пользователи",
      "description": "Только администратор"
    },
    {
      "name": "Система"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Авторизация"
        ],
        "summary": "Войти по логину и паролю",
        "operationId": "login",
        "security": [],
        "description": "Ставит cookie `invoice_session`. 10 неудачных попыток за 5 минут с одного адреса или для одного логина → 429.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Вход выполнен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "invoice_session=…; HttpOnly; SameSite=Strict",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Авторизация"
        ],
        "summary": "Текущая учётная запись и CSRF-токен",
        "operationId": "me",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Текущий пользователь",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Авторизация"
        ],
        "summary": "Завершить текущую сессию",
        "operationId": "logout",
        "security": [
          {
            "cookieAuth": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Сессия удалена, cookie очищена"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/recurring-payments": {
      "get": {
        "tags": [
          "Регулярные платежи"
        ],
        "summary": "Список регулярных платежей, включая архив",
        "operationId": "listRecurringPayments",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Активные сначала, затем архив",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecurringPayment"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Регулярные платежи"
        ],
        "summary": "Добавить ежемесячный платёж",
        "operationId": "createRecurringPayment",
        "security": [
          {
            "cookieAuth": [],
            "csrfToken": []
          }
        ],
        "description": "Только администратор. Создаёт периоды до конца следующего месяца. Если до срока не больше 3 дней, напоминание проверяется сразу.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecurringCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Платёж создан",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecurringCreated"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/api/v1/recurring-payments/{payment_id}": {
      "delete": {
        "tags": [
          "Регулярные платежи"
        ],
        "summary": "Прекратить повторение, сохранив историю",
        "operationId": "archiveRecurringPayment",
        "security": [
          {
            "cookieAuth": [],
            "csrfToken": []
          }
        ],
        "description": "Только администратор. Новые периоды и напоминания больше не создаются; созданные периоды и оплаты остаются. Повторный вызов тоже возвращает 204.",
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "description": "ID регулярного платежа",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Платёж в архиве"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/api/v1/payment-occurrences": {
      "get": {
        "tags": [
          "Оплаты"
        ],
        "summary": "Периоды оплаты: к оплате, оплаченные и просроченные",
        "operationId": "listOccurrences",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "from_date",
            "in": "query",
            "description": "Срок оплаты не раньше этой даты",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to_date",
            "in": "query",
            "description": "Срок оплаты не позже этой даты",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Status"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Currency"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Подстрока названия без учёта регистра",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "include_archived",
            "in": "query",
            "description": "Учитывать периоды прекращённых платежей",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Отсортировано по сроку",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Occurrence"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/api/v1/payment-occurrences/{occurrence_id}": {
      "get": {
        "tags": [
          "Оплаты"
        ],
        "summary": "Один период оплаты",
        "operationId": "getOccurrence",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "occurrence_id",
            "in": "path",
            "required": true,
            "description": "ID периода",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Период",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Occurrence"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      },
      "patch": {
        "tags": [
          "Оплаты"
        ],
        "summary": "Отметить или отменить оплату, исправить фактическую дату",
        "operationId": "updateOccurrence",
        "security": [
          {
            "cookieAuth": [],
            "csrfToken": []
          }
        ],
        "description": "Доступно и пользователю, и администратору. Меняет только этот период; срок не меняется, просрочка пересчитывается.",
        "parameters": [
          {
            "name": "occurrence_id",
            "in": "path",
            "required": true,
            "description": "ID периода",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OccurrencePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Период после изменения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Occurrence"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/api/v1/payments/summary": {
      "get": {
        "tags": [
          "Оплаты"
        ],
        "summary": "Итоги по RUB, USD и EUR без конвертации",
        "operationId": "paymentsSummary",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "description": "Периоды отбираются по сроку оплаты. `unpaid` включает `overdue`; `total = paid + unpaid`.",
        "parameters": [
          {
            "name": "from_date",
            "in": "query",
            "description": "Начало периода (по сроку)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to_date",
            "in": "query",
            "description": "Конец периода (по сроку)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "include_archived",
            "in": "query",
            "description": "Учитывать периоды прекращённых платежей",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Итоги",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "Пользователи"
        ],
        "summary": "Обычные пользователи",
        "operationId": "listUsers",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Без администратора",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeamUser"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Пользователи"
        ],
        "summary": "Создать обычного пользователя",
        "operationId": "createUser",
        "security": [
          {
            "cookieAuth": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь создан",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamUser"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/api/v1/users/{user_id}": {
      "patch": {
        "tags": [
          "Пользователи"
        ],
        "summary": "Изменить пользователя",
        "operationId": "updateUser",
        "security": [
          {
            "cookieAuth": [],
            "csrfToken": []
          }
        ],
        "description": "Новый пароль завершает все сессии пользователя. `user_id = 0` — администратор, он управляется только через `.env` (403).",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "description": "ID пользователя",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Пользователь после изменения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamUser"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      },
      "delete": {
        "tags": [
          "Пользователи"
        ],
        "summary": "Удалить пользователя и его сессии",
        "operationId": "deleteUser",
        "security": [
          {
            "cookieAuth": [],
            "csrfToken": []
          }
        ],
        "description": "История его действий и оплат сохраняется.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "description": "ID пользователя",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Удалён"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "tags": [
          "Система"
        ],
        "summary": "Часовой пояс, текущая дата и состояние Telegram",
        "operationId": "settings",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Настройки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/reminders": {
      "get": {
        "tags": [
          "Система"
        ],
        "summary": "Журнал отправки напоминаний (последние 100)",
        "operationId": "listReminders",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Только администратор",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reminder"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/audit-log": {
      "get": {
        "tags": [
          "Система"
        ],
        "summary": "Последние 100 действий",
        "operationId": "auditLog",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Только администратор",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEntry"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "Система"
        ],
        "summary": "Доступность приложения и базы",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Работает",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "invoice_session",
        "description": "Ставится при входе"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "`csrf_token` из /auth/login или /auth/me"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Нет сессии или она завершена",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Нет прав, нет CSRF-токена или запрос с другого сайта",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Запись не найдена",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Логин занят или принадлежит администратору",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Validation": {
        "description": "Неверные данные; введённые значения в ответ не возвращаются",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Слишком много попыток входа",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "Через сколько секунд повторить",
            "schema": {
              "type": "integer"
            }
          }
        }
      }
    },
    "schemas": {
      "Currency": {
        "type": "string",
        "enum": [
          "RUB",
          "USD",
          "EUR"
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "paid",
          "unpaid",
          "overdue"
        ],
        "description": "`overdue` — не оплачено и срок прошёл (со следующего дня после срока)"
      },
      "Money": {
        "type": "string",
        "pattern": "^\\d{1,10}\\.\\d{2}$",
        "example": "45000.00"
      },
      "Error": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "example": "Действие доступно только администратору"
          }
        }
      },
      "FieldError": {
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "properties": {
          "loc": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ]
            },
            "example": [
              "body",
              "amount"
            ]
          },
          "msg": {
            "type": "string",
            "example": "Сумма должна быть больше нуля"
          },
          "type": {
            "type": "string",
            "example": "greater_than"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                }
              }
            ]
          }
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "admin"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "csrf_token"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "0 — администратор из .env"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "user"
            ]
          },
          "csrf_token": {
            "type": "string",
            "description": "Передавайте в X-CSRF-Token"
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "timezone",
          "today",
          "telegram_enabled",
          "reminder_days",
          "reminder_interval_seconds"
        ],
        "properties": {
          "timezone": {
            "type": "string",
            "example": "Europe/Moscow"
          },
          "today": {
            "type": "string",
            "format": "date",
            "example": "2026-10-25"
          },
          "telegram_enabled": {
            "type": "boolean"
          },
          "reminder_days": {
            "type": "integer",
            "example": 3
          },
          "reminder_interval_seconds": {
            "type": "integer",
            "example": 60
          }
        }
      },
      "RecurringCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "amount",
          "currency",
          "first_due_date"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Облачный сервер"
          },
          "amount": {
            "description": "Больше нуля, не более 10 цифр до точки и 2 после",
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d{1,10}(\\.\\d{1,2})?$"
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ],
            "example": "24.00"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "first_due_date": {
            "type": "string",
            "format": "date",
            "example": "2026-10-25",
            "description": "Первый срок; его число — якорь повторения (31 → последний день короткого месяца). 2000–2100."
          },
          "frequency": {
            "type": "string",
            "enum": [
              "monthly"
            ],
            "default": "monthly"
          }
        }
      },
      "RecurringCreated": {
        "type": "object",
        "required": [
          "id",
          "title",
          "amount",
          "currency",
          "first_due_date",
          "frequency",
          "active"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "first_due_date": {
            "type": "string",
            "format": "date",
            "example": "2026-10-25"
          },
          "frequency": {
            "const": "monthly"
          },
          "active": {
            "const": true
          }
        }
      },
      "RecurringPayment": {
        "type": "object",
        "required": [
          "id",
          "title",
          "amount",
          "currency",
          "first_due_date",
          "anchor_day",
          "frequency",
          "active",
          "unpaid_count",
          "created_at",
          "deleted_at"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "first_due_date": {
            "type": "string",
            "format": "date",
            "example": "2026-10-25"
          },
          "anchor_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "frequency": {
            "const": "monthly"
          },
          "active": {
            "type": "boolean",
            "description": "false — в архиве"
          },
          "unpaid_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Occurrence": {
        "type": "object",
        "required": [
          "id",
          "recurring_payment_id",
          "title",
          "amount",
          "currency",
          "due_date",
          "paid_at",
          "status",
          "days_overdue",
          "is_late",
          "active",
          "updated_by"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "recurring_payment_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "example": "2026-10-25"
          },
          "paid_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "example": null,
            "description": "Фактическая дата оплаты; null — не оплачено"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "days_overdue": {
            "type": "integer",
            "minimum": 0,
            "description": "По фактической дате для оплаченного, по сегодняшней — для неоплаченного"
          },
          "is_late": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean",
            "description": "Регулярный платёж не в архиве"
          },
          "updated_by": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OccurrencePatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "description": "Оплатить: `{\"paid\": true}` (сегодня) или `{\"paid\": true, \"paid_at\": \"2026-10-23\"}`. Исправить дату: `{\"paid_at\": \"2026-10-22\"}`. Отменить: `{\"paid\": false}` или `{\"paid_at\": null}` — дата очищается. Дата не может быть в будущем.",
        "properties": {
          "paid": {
            "type": "boolean"
          },
          "paid_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "example": null
          }
        }
      },
      "CurrencyTotals": {
        "type": "object",
        "required": [
          "total",
          "paid",
          "unpaid",
          "overdue",
          "count"
        ],
        "properties": {
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "paid": {
            "$ref": "#/components/schemas/Money"
          },
          "unpaid": {
            "$ref": "#/components/schemas/Money"
          },
          "overdue": {
            "$ref": "#/components/schemas/Money"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "Summary": {
        "type": "object",
        "required": [
          "from_date",
          "to_date",
          "currencies"
        ],
        "properties": {
          "from_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "example": null
          },
          "to_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "example": null
          },
          "currencies": {
            "type": "object",
            "required": [
              "RUB",
              "USD",
              "EUR"
            ],
            "properties": {
              "RUB": {
                "$ref": "#/components/schemas/CurrencyTotals"
              },
              "USD": {
                "$ref": "#/components/schemas/CurrencyTotals"
              },
              "EUR": {
                "$ref": "#/components/schemas/CurrencyTotals"
              }
            }
          }
        }
      },
      "TeamUser": {
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "const": "user"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "display_name",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "example": "alexey"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "Алексей Иванов"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 128
          }
        }
      },
      "UserPatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 128
          }
        }
      },
      "Reminder": {
        "type": "object",
        "required": [
          "occurrence_id",
          "state",
          "attempts",
          "attempted_at",
          "retry_after",
          "sent_at",
          "message_id",
          "error",
          "title",
          "due_date"
        ],
        "properties": {
          "occurrence_id": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "sending",
              "sent",
              "uncertain",
              "cancelled"
            ],
            "description": "`uncertain` — результат неизвестен, автоматического повтора нет (без дублей)"
          },
          "attempts": {
            "type": "integer"
          },
          "attempted_at": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Unix-время"
          },
          "retry_after": {
            "type": "integer",
            "description": "Unix-время"
          },
          "sent_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "message_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "example": "2026-10-25"
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "required": [
          "id",
          "actor",
          "action",
          "entity",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "example": "occurrence.paid",
            "description": "login, recurring.create, recurring.archive, occurrence.paid, occurrence.unpaid, user.create, user.update, user.delete"
          },
          "entity": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
