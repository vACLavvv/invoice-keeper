# Скопируйте в .env или выполните `go run ./cmd/invoice-keeper bootstrap --demo` — он создаст .env сам.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Ключ шифрования секретов, чеков и реквизитов в базе: invoice-keeper keygen. Храните копию отдельно
# от базы и бэкапов — без него зашифрованное не прочитать. Неверный ключ сервер не примет.
DATA_ENCRYPTION_KEY=
APP_TIMEZONE=Europe/Moscow
DATABASE_PATH=./data/invoice-keeper.sqlite3
SESSION_HOURS=12
COOKIE_SECURE=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMINDER_INTERVAL_SECONDS=60
# Повторное напоминание на следующий день после неоплаченного срока (true/false)
OVERDUE_REMINDERS=true
# MAX: бот в общем чате с кнопкой «Оплачено». ID чата подскажет команда /chatid в чате с ботом
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# Если система не доверяет сертификату API MAX — путь к корневому сертификату (PEM)
MAX_CA_FILE=
# Email-напоминания: нужны SMTP_HOST, SMTP_FROM и SMTP_TO (несколько адресов через запятую)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# starttls (порт 587), ssl (465) или none
SMTP_SECURITY=starttls
# Webhook: напоминания POST-запросом с JSON; с секретом — подпись X-Invoice-Keeper-Signature
WEBHOOK_URL=
WEBHOOK_SECRET=
# Сверка криптокошельков получателей со списком санкций OFAC (SDN). Список скачивается,
# только пока хотя бы у одного платежа указан кошелёк. Без интернета: invoice-keeper ofac-update --file SDN.XML
OFAC_ENABLED=true
OFAC_REFRESH_HOURS=24
# OFAC_LIST_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML
# Сообщение в привязанный Telegram о каждом входе и о подборе пароля
LOGIN_ALERTS=true
# «Оплачено» в Telegram — только от участников, привязавших аккаунт в панели
TELEGRAM_PAID_LINKED_ONLY=true
# Ключи расширения и токены API, которыми не пользовались столько дней, отключаются (0 — никогда)
KEY_IDLE_DAYS=90
# Лимит запросов к API на адрес или токен: в секунду и всплеск
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=120
# Контакты поддержки на странице «Помощь» (необязательно)
SUPPORT_TELEGRAM=
SUPPORT_EMAIL=
# Только для bootstrap --demo
DEMO_USERNAME=teammate
DEMO_PASSWORD=replace-with-another-long-password
