# Скопируйте в .env или выполните `go run ./cmd/invoice-keeper bootstrap --demo` — он создаст .env сам.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Ключ шифрования секретов, чеков и реквизитов в базе: invoice-keeper keygen. Храните копию отдельно
# от базы и бэкапов — без него зашифрованное не прочитать. Неверный ключ сервер не примет.
DATA_ENCRYPTION_KEY=
APP_TIMEZONE=Europe/Moscow
DATABASE_PATH=./data/invoice-keeper.sqlite3
SESSION_HOURS=12
COOKIE_SECURE=false
# За reverse proxy (nginx): адрес, который открывают пользователи. Origin запросов сверяется с ним,
# а при https cookie по умолчанию становятся Secure.
PUBLIC_BASE_URL=
# Прокси, которым верим X-Forwarded-For (IP или CIDR через запятую), например 127.0.0.1,::1.
# Без него за nginx все клиенты выглядят как 127.0.0.1 и делят один лимит входа.
TRUSTED_PROXIES=
# Журнал запросов: метод, путь, статус, время, IP. Заголовки, cookie и значения параметров не пишутся.
LOG_REQUESTS=true
# text или json
LOG_FORMAT=text
# Независимый ключ Prometheus (>=32 символов); пусто — /metrics выключен.
METRICS_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMINDER_INTERVAL_SECONDS=60
# Повторное напоминание на следующий день после неоплаченного срока (true/false)
OVERDUE_REMINDERS=true
# MAX: бот в общем чате с кнопкой «Оплачено». ID чата подскажет команда /chatid в чате с ботом
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# Если система не доверяет сертификату API MAX — путь к корневому сертификату (PEM)
MAX_CA_FILE=
# Личные письма: SMTP_HOST и SMTP_FROM. SMTP_TO оставьте пустым для отправки только пользователям.
# Необязательная общая рассылка: SMTP_TO (адреса через запятую).
# Отображаемое имя: SMTP_FROM="aezakeeper <sender@yandex.ru>"
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# starttls (порт 587), ssl (465) или none
SMTP_SECURITY=starttls
# Webhook: эти три переменные нужны только для одноразового импорта старой конфигурации в БД.
# Импорт выполняется при первом serve версии со схемой 10; отметка сохраняется даже при пустом URL.
# bootstrap отметку не создаёт: старые настройки можно внести после него, до первого serve.
# После первого serve управляйте получателями в панели «Вебхук»; изменения .env не повторяют импорт.
# Напоминания отправляются POST-запросом с JSON; с секретом — подпись X-Invoice-Keeper-Signature.
WEBHOOK_URL=
WEBHOOK_SECRET=
# По умолчанию webhook не ходит на 127.0.0.1, 10.x, 192.168.x, 169.254.x (метаданные облака) и т. п.
# Для импорта получателя на этом же сервере или в локальной сети задайте true до первого serve.
WEBHOOK_ALLOW_PRIVATE=false
# Сверка криптокошельков получателей со списком санкций OFAC (SDN). Список скачивается,
# только пока хотя бы у одного платежа указан кошелёк. Без интернета: invoice-keeper ofac-update --file SDN.XML
OFAC_ENABLED=true
OFAC_REFRESH_HOURS=24
# OFAC_LIST_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML
# Сообщение в привязанный Telegram о каждом входе и о подборе пароля
LOGIN_ALERTS=true
# «Оплачено» в Telegram — только от участников, привязавших аккаунт в панели
TELEGRAM_PAID_LINKED_ONLY=true
# Ключи расширения и токены API, которыми не пользовались столько дней, отключаются (0 — никогда)
KEY_IDLE_DAYS=90
# Лимит запросов к API на адрес или токен: в секунду и всплеск
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=120
# Контакты поддержки на странице «Помощь» (необязательно)
SUPPORT_TELEGRAM=
SUPPORT_EMAIL=
# Только для bootstrap --demo
DEMO_USERNAME=teammate
DEMO_PASSWORD=replace-with-another-long-password
