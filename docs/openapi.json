  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "OccurrencePatch": {
        "properties": {
          "paid": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paid"
          },
          "paid_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paid At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "OccurrencePatch"
      },
      "RecurringCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "examples": [
              "Аренда офиса"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "45000.00"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB",
              "USD",
              "EUR"
            ],
            "title": "Currency"
          },
          "first_due_date": {
            "type": "string",
            "format": "date",
            "title": "First Due Date"
          },
          "frequency": {
            "type": "string",
            "const": "monthly",
            "title": "Frequency",
            "default": "monthly"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "amount",
          "currency",
          "first_due_date"
        ],
        "title": "RecurringCreate"
      },
      "UserCreate": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "display_name",
          "password"
        ],
        "title": "UserCreate"
      },
      "UserPatch": {
        "properties": {
          "username": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 3,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "password": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 12
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "UserPatch"
      },
      "ValidationError": {
        "properties": {
          "loc": {
