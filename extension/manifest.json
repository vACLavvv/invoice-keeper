{
  "manifest_version": 3,
  "name": "Invoice Keeper",
  "version": "1.1.0",
  "description": "Находит регулярные платежи на открытой странице и отправляет их в Invoice Keeper. Читает страницу только по клику.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Invoice Keeper: найти платежи на этой странице",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "browser_specific_settings": { "gecko": { "id": "invoice-keeper@extension", "strict_min_version": "128.0" } }
}
